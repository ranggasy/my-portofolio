            >
              <Icon name="simple-icons:github" class="h-5 w-5" />
            </a>
            <a
              href="https://www.linkedin.com/in/rangga-syafutra-dewa-08a863270/"
              target="_blank"
              rel="noreferrer"
              aria-label="LinkedIn"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-neutral-200 bg-white text-neutral-800 transition-all hover:border-neutral-400 hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200 dark:hover:border-neutral-700 dark:hover:bg-neutral-800"
            >
