---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta
      name="description"
      content="Portofolio Rangga, Web Developer yang membangun aplikasi web modern dan bermanfaat."
    />
    <title>Rangga | Web Developer</title>

    <!-- Script Anti-FOUC (Cek Tema Awal) -->
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body
    class="bg-white font-sans text-neutral-900 antialiased overflow-x-hidden dark:bg-[#030712] dark:text-neutral-100"
  >
    <!-- Efek Background Meteor -->
    <Meteors number={25} />
    <!-- Navbar Sticky -->
    <header
      class="sticky top-0 z-40 border-b border-neutral-100 bg-white/95 backdrop-blur-md dark:border-neutral-800/60 dark:bg-[#030712]/90"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-10"
      >
        <a
          href="#home"
          class="shrink-0 text-lg font-extrabold tracking-tight text-neutral-950 dark:text-white"
          aria-label="Rangga, kembali ke halaman utama"
        >
          ◢ Rangga
        </a>

        <!-- Navigasi Utama dengan Indikator Aktif (Pill Style) -->
        <nav
          id="nav-menu"
          class="hidden items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 md:flex"
        >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#home">Home</a
          >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#about">About</a
          >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#skills">Skills</a
          >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#projects">Projects</a
          >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#experience">Experience</a
          >
          <a
            class="nav-link rounded-xl px-3.5 py-2 font-medium transition-all hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800/80 dark:hover:text-white"
            href="#contact">Contact</a
          >

          <span
            class="mx-1 text-neutral-300 dark:text-neutral-700"
            aria-hidden="true">|</span
          >

          <!-- Tombol Switch Dark Mode -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-200 bg-white text-neutral-700 transition-all hover:border-neutral-400 hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:border-neutral-700 dark:hover:bg-neutral-800"
          >
            <span class="icon-moon">
              <Icon name="lucide:moon" class="h-4 w-4 text-neutral-700" />
            </span>
            <span class="icon-sun">
              <Icon name="lucide:sun" class="h-4 w-4 text-amber-400" />
            </span>
          </button>
        </nav>

        <div class="flex items-center gap-2 md:hidden">
          <button
            id="theme-toggle-mobile"
            type="button"
            aria-label="Ganti tema"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-200 bg-white text-neutral-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200"
          >
            <span class="icon-moon"
              ><Icon name="lucide:moon" class="h-4 w-4" /></span
            >
            <span class="icon-sun"
              ><Icon name="lucide:sun" class="h-4 w-4 text-amber-400" /></span
            >
          </button>
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Buka menu navigasi"
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-200 bg-white text-neutral-800 transition hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800"
          >
            <Icon name="lucide:menu" class="mobile-menu-open h-5 w-5" />
            <Icon name="lucide:x" class="mobile-menu-close hidden h-5 w-5" />
          </button>
        </div>
      </div>

      <nav
        id="mobile-nav-menu"
        aria-label="Navigasi mobile"
        class="mobile-nav-panel hidden border-t border-neutral-200 bg-white px-5 pb-5 pt-3 shadow-lg dark:border-neutral-800 dark:bg-[#080d18] md:hidden"
