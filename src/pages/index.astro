    <!-- Script View Transitions Smooth -->
    <script>
      const themeToggles = [
        document.getElementById("theme-toggle"),
        document.getElementById("theme-toggle-mobile"),
      ].filter((button): button is HTMLElement => button !== null);

      themeToggles.forEach((themeToggle) => {
        themeToggle.addEventListener("click", (event) => {
          const isDark = document.documentElement.classList.contains("dark");
          const nextThemeIsDark = !isDark;

          const toggleThemeDOM = () => {
            document.documentElement.classList.toggle("dark", nextThemeIsDark);
            localStorage.setItem("theme", nextThemeIsDark ? "dark" : "light");
          };

          if (
            !("startViewTransition" in document) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            toggleThemeDOM();
            return;
          }

          const rect = themeToggle.getBoundingClientRect();
          const pointerEvent = event as MouseEvent;
          const x = pointerEvent.clientX || rect.left + rect.width / 2;
          const y = pointerEvent.clientY || rect.top + rect.height / 2;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          );

          const transition = (document as any).startViewTransition(() => {
            toggleThemeDOM();
          });

          transition.ready.then(() => {
            document.documentElement.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${endRadius}px at ${x}px ${y}px)`,
                ],
              },
              {
                duration: 450,
                easing: "cubic-bezier(0.25, 1, 0.5, 1)",
                pseudoElement: "::view-transition-new(root)",
              },
            );
          });
        });
      });

      const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
      const mobileNavMenu = document.getElementById("mobile-nav-menu");
      const mobileMenuOpenIcon =
        mobileMenuToggle?.querySelector(".mobile-menu-open");
      const mobileMenuCloseIcon =
        mobileMenuToggle?.querySelector(".mobile-menu-close");

      function closeMobileMenu() {
        mobileNavMenu?.classList.add("hidden");
        mobileMenuToggle?.setAttribute("aria-expanded", "false");
        mobileMenuToggle?.setAttribute("aria-label", "Buka menu navigasi");
        mobileMenuOpenIcon?.classList.remove("hidden");
        mobileMenuCloseIcon?.classList.add("hidden");
      }

      mobileMenuToggle?.addEventListener("click", () => {
        const isExpanded =
          mobileMenuToggle.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeMobileMenu();
        } else {
          mobileNavMenu?.classList.remove("hidden");
          mobileMenuToggle.setAttribute("aria-expanded", "true");
          mobileMenuToggle.setAttribute("aria-label", "Tutup menu navigasi");
          mobileMenuOpenIcon?.classList.add("hidden");
          mobileMenuCloseIcon?.classList.remove("hidden");
        }
      });

      mobileNavMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMobileMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMobileMenu();
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) closeMobileMenu();
      });
    </script>

    <!-- Script Auto Active Navigation Link berdasarkan Scroll Position -->
    <script>
      function initActiveNav() {
        const navLinks =
          document.querySelectorAll<HTMLAnchorElement>(".nav-link");
        const sections = document.querySelectorAll<HTMLElement>("section[id]");

        if (!navLinks.length || !sections.length) return;

        const activeClasses = [
          "bg-neutral-100",
          "text-neutral-950",
          "font-semibold",
          "dark:bg-neutral-800",
          "dark:text-white",
        ];

        function setActiveLink(id: string) {
          navLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === `#${id}`) {
              link.classList.add(...activeClasses);
            } else {
              link.classList.remove(...activeClasses);
            }
          });
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setActiveLink(entry.target.id);
              }
            });
          },
          {
            rootMargin: "-25% 0px -50% 0px",
          },
        );

        sections.forEach((section) => observer.observe(section));
      }

      document.addEventListener("DOMContentLoaded", initActiveNav);
      initActiveNav();

      const projectImageDialog = document.getElementById(
        "project-image-dialog",
      ) as HTMLDialogElement | null;
      const projectImageDialogImg = document.getElementById(
        "project-image-dialog-img",
      ) as HTMLImageElement | null;
      const projectImageCaption = document.getElementById(
        "project-image-caption",
      );

      document
        .querySelectorAll<HTMLButtonElement>(".project-image-preview")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const imageSrc = button.dataset.previewSrc;
            const imageAlt =
              button.dataset.previewAlt || "Preview gambar project";
            if (!imageSrc || !projectImageDialog || !projectImageDialogImg)
              return;

            projectImageDialogImg.src = imageSrc;
            projectImageDialogImg.alt = imageAlt;
            if (projectImageCaption)
              projectImageCaption.textContent = imageAlt.replace(
                "Preview tampilan website ",
                "",
              );
            projectImageDialog.showModal();
          });
        });

      document
        .getElementById("close-project-image-dialog")
        ?.addEventListener("click", () => {
          projectImageDialog?.close();
        });

      projectImageDialog?.addEventListener("click", (event) => {
        if (event.target === projectImageDialog) projectImageDialog.close();
      });

      projectImageDialog?.addEventListener("close", () => {
        if (projectImageDialogImg) projectImageDialogImg.src = "";
      });

      const internshipGallery = document.getElementById(
        "internship-gallery",
      ) as HTMLDialogElement | null;
      const finalProjectGallery = document.getElementById(
        "final-project-gallery",
      ) as HTMLDialogElement | null;

      document
        .getElementById("open-internship-gallery")
        ?.addEventListener("click", () => internshipGallery?.showModal());
      document
        .getElementById("close-internship-gallery")
        ?.addEventListener("click", () => internshipGallery?.close());
      internshipGallery?.addEventListener("click", (event) => {
        if (event.target === internshipGallery) internshipGallery.close();
      });

      document
        .getElementById("open-final-project-gallery")
        ?.addEventListener("click", () => finalProjectGallery?.showModal());
      document
        .getElementById("close-final-project-gallery")
        ?.addEventListener("click", () => finalProjectGallery?.close());
      finalProjectGallery?.addEventListener("click", (event) => {
        if (event.target === finalProjectGallery) finalProjectGallery.close();
      });
    </script>
  </body>
</html>
