        class="relative mx-auto grid max-w-7xl items-center gap-5 px-5 pb-10 pt-6 sm:px-8 sm:gap-7 md:min-h-[620px] md:grid-cols-2 md:gap-10 md:py-12 lg:px-10 lg:py-14 overflow-hidden"
