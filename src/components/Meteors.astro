---
// src/components/Meteors.astro
interface Props {
  number?: number;
}

const { number = 16 } = Astro.props; // Jumlah ideal agar tetap sangat ringan saat scroll
const meteors = new Array(number).fill(true);
---

<!-- Fixed Inset-0 agar Selalu Mengikuti Layar Layar / Viewport saat Di-scroll -->
<div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
  {
    meteors.map(() => {
      const left = Math.floor(Math.random() * 130 - 15) + "%";
      const delay = (Math.random() * 7).toFixed(2) + "s";
      const duration = (Math.random() * 4 + 3.5).toFixed(2) + "s";

      return (
        <span
          class="animate-meteor absolute top-[-20px] h-0.5 w-0.5 rounded-full bg-blue-400 dark:bg-sky-300 shadow-[0_0_0_1px_#ffffff10] will-change-transform"
          style={`left: ${left}; animation-delay: ${delay}; animation-duration: ${duration};`}
        >
          {/* Ekor Cahaya Meteor */}
          <span class="pointer-events-none absolute top-1/2 -z-10 h-[1px] w-[75px] -translate-y-1/2 bg-gradient-to-r from-blue-500 via-indigo-400 to-transparent dark:from-sky-400 dark:via-blue-500 dark:to-transparent" />
        </span>
      );
    })
  }
</div>

<style>
  @keyframes meteor {
    0% {
      transform: rotate(215deg) translateX(0);
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: rotate(215deg) translateX(-850px);
      opacity: 0;
    }
  }

  .animate-meteor {
    animation: meteor linear infinite;
  }
</style>